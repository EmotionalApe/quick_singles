# ==============================================
# Cricket Scorer - Root Environment Configuration Template
# Copy this file to .env to configure Docker Compose or local runs
# ==============================================

# Database Settings
POSTGRES_USER=cricket
POSTGRES_PASSWORD=cricket
POSTGRES_DB=cricket_scorer
POSTGRES_PORT=5432

# Backend Service Settings
ENVIRONMENT=production
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173,http://localhost:3000
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Frontend Service Settings
FRONTEND_PORT=80
VITE_API_BASE_URL=
