# ==============================================
# Frontend Environment Configuration Template
# Copy this file to .env and adjust the values
# ==============================================

# API Base URL
# - Local development (using Vite dev server proxy):
#   Leave empty so frontend requests go to relative '/matches' and are proxied by Vite.
# - Production deployment (e.g., Vercel, Netlify, Cloudflare Pages):
#   Set to the public URL of your backend API, e.g. https://cricket-scorer-api.onrender.com
#   (Note: no trailing slash)
VITE_API_BASE_URL=

# Local Dev Proxy Target
# Target backend server for Vite dev proxy when running locally
VITE_PROXY_TARGET=http://127.0.0.1:8000
