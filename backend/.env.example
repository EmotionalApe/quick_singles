# ==============================================
# Backend Environment Configuration Template
# Copy this file to .env and adjust the values
# ==============================================

# Application environment: "development" | "production" | "staging"
ENVIRONMENT=development
APP_NAME=Cricket Scorer

# Server binding
HOST=0.0.0.0
PORT=8000

# PostgreSQL Database Connection String
# Format: postgresql+psycopg://<username>:<password>@<host>:<port>/<dbname>
# For local Docker: postgresql+psycopg://cricket:cricket@localhost:5432/cricket_scorer
# For Neon/Supabase: postgresql+psycopg://<user>:<password>@<neon-host>/<dbname>?sslmode=require
DATABASE_URL=postgresql+psycopg://cricket:cricket@localhost:5432/cricket_scorer

# Allowed CORS Origins (comma-separated list or JSON array)
# In production, set to your frontend domain, e.g. https://your-frontend.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Cookie Configuration for Scorer Authentication
# In production (HTTPS), set COOKIE_SECURE=true
# If frontend and backend are on different domains in production (e.g. vercel + render):
# set COOKIE_SECURE=true and COOKIE_SAMESITE=none
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Optional cookie domain (e.g. .yourdomain.com):
COOKIE_DOMAIN=
